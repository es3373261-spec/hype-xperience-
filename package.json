{
  "name": "hype-xperience",
  "version": "1.0.0",
  "private": true,
  "description": "App que gestiona y conecta todos los servicios turísticos de Acapulco en un solo lugar",
  "workspaces": [
    "app",
    "functions",
    "admin"
  ],
  "scripts": {
    "test": "npm run test --workspace=app && npm run test --workspace=functions",
    "test:app": "npm run test --workspace=app",
    "test:functions": "npm run test --workspace=functions",
    "emulators": "firebase emulators:start --only auth,firestore,functions"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}

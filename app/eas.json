{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "onebypro-b0d7d",
        "EXPO_PUBLIC_ENV": "development"
      }
    },
    "pilot": {
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "onebypro-b0d7d",
        "EXPO_PUBLIC_ENV": "pilot"
      }
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "onebypro-b0d7d",
        "EXPO_PUBLIC_ENV": "production"
      }
    }
  },
  "submit": {
    "pilot": {
      "ios": {
        "ascAppId": "PENDING_PEDRO_ASC_APP_ID"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
